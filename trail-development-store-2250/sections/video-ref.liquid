{% schema %}
{
  "name": "Video with Logo & Button",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Video with Logo and Button"
    }
  ]
}
{% endschema %}

{% assign video_id = section.settings.video.id %}
{% assign poster = section.settings.video.preview_image %}
{% assign fix_ratio = true %}

<deferred-media
  class="video-section__media deferred-media gradient global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  data-media-id="{{ video_id }}"
  {% if poster != null %}
    style="--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
  {% endif %}
>
  {% if section.settings.video != blank %}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
  {% endif %}

  <!-- Overlay container for logo and button -->
  <div class="video-overlay">
    {% if section.settings.logo_image != blank %}
      <img 
        src="{{ section.settings.logo_image | image_url: width: 200 }}" 
        alt="Logo" 
        class="video-logo"
      >
    {% endif %}

    {% if section.settings.shop_button_text != blank %}
      <a 
        href="{{ section.settings.shop_button_link }}" 
        class="shop-now-btn"
      >
        {{ section.settings.shop_button_text }}
      </a>
    {% endif %}
  </div>
</deferred-media>

<style>
.video-section__media {
  position: relative;
  overflow: hidden;
  border-radius: 16px;
}

.video-section__media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Overlay container */
.video-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  background: rgba(0, 0, 0, 0.3); /* optional semi-transparent overlay */
  text-align: center;
}

/* Logo style */
.video-logo {
  width: 180px;
  height: auto;
  object-fit: contain;
  margin-bottom: 10px;
}

/* Shop Now button style */
.shop-now-btn {
  display: inline-block;
  background: #ffffff;
  color: #000000;
  font-weight: 600;
  padding: 12px 28px;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.shop-now-btn:hover {
  background: #000;
  color: #fff;
  transform: scale(1.05);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .video-logo {
    width: 130px;
  }
  .shop-now-btn {
    padding: 10px 20px;
    font-size: 14px;
  }
}
</style>
